# Copy to .env and fill in what you need. Everything is optional except
# RELAY_DOMAIN when you use deploy/docker-compose.yml (Caddy needs it for HTTPS).

# Public hostname of this relay; point its DNS A/AAAA record at this server.
RELAY_DOMAIN=relay.example.com

# Listen address of the relay process itself (Caddy talks to it).
# PORT=8787
# HOST=0.0.0.0

# Access control. Leave both empty for a personal relay: a desktop is only
# reachable with its 256-bit connect code anyway. Set one to stop strangers
# from parking tunnels on your server.
#   Shared key — paste it into Alma → Settings → Remote Access as the token.
RELAY_REGISTRATION_KEY=
#   Per-user signed tokens (HS256, aud "alma-relay"); mint with
#   `docker compose exec relay node scripts/mint-token.mjs <user>`.
RELAY_TOKEN_SECRET=

# Max request body through the tunnel, in MB.
# MAX_BODY_MB=128

# Resource limits (Node edition). 0 means no limit.
# MAX_BUFFERED_MB=512          # all request bodies held in memory at once
# MAX_AGENTS=10000             # desktops connected at once
# MAX_REQUESTS_PER_AGENT=256   # concurrent HTTP requests per desktop
# MAX_SOCKETS_PER_AGENT=256    # concurrent WebSockets per desktop
# MAX_CONNECTIONS=             # TCP connections to the process
# STALL_TIMEOUT_S=60           # cut off a phone that reads nothing this long
#                              # (or a protocol-2 desktop that takes no upload)

# Newest protocol offered to desktops. 1 turns off streamed uploads and binary
# frames (protocol 2) without touching the desktops.
# RELAY_PROTOCOL=2

# Phone notifications (APNs). Only works with the key of the team that signs
# the iOS app — see README.
# APNS_KEY_FILE=/run/secrets/apns.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=me.yetone.alma

# Android notifications (FCM): the Firebase service-account JSON of the
# project the Android app is registered in.
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json

# TURN for the phone's live view of the desktop browser (WebRTC).
# With the `turn` compose profile, use your RELAY_DOMAIN here.
# TURN_URLS=stun:relay.example.com:3478,turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp
# TURN_SECRET=
